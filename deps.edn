{:paths ["src"]
 ;; org-ietf-deflate supplies CRC-32, which .xz uses for every structural field
 ;; (stream flags, block header, index, footer). One CRC-32 in the workspace.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/org-ietf-deflate {:git/sha "430d754313e9082114ec00554e0b6770d9d318c5"}
        ;; org-nist-sha2 supplies the SHA-256 that a `--check=sha256` stream
        ;; needs. Before it existed the only options were injecting a host hash
        ;; or refusing the file; a compression library still should not contain a
        ;; hash implementation, but it can depend on one.
        io.github.kotoba-lang/org-nist-sha2 {:git/sha "3b4f7e93eff2c438c758383bab440b6f35627e31"}}
 :aliases
 {:local {:override-deps {io.github.kotoba-lang/org-ietf-deflate {:local/root "../org-ietf-deflate"}
                          io.github.kotoba-lang/org-nist-sha2 {:local/root "../org-nist-sha2"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
